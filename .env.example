# Copy to .env and fill in real values. Never commit .env.
# SQL Server requires a strong password (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=
# At least 32 random bytes, e.g. output of: openssl rand -base64 48
JWT_SIGNING_KEY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Optional: password for the demo accounts lincoln.clerk, roosevelt.clerk and district.viewer (Development only).
DEMO_USER_PASSWORD=
